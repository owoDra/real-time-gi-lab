    "annotation_criteria": {
      "control_max_abs_process_median_ratio": 1.03,
      "control_process_median_span_ratio": 1.05,
      "control_max_within_process_order_bias_ratio": 1.03,
      "candidate_process_effect_span_ratio": 1.08,
