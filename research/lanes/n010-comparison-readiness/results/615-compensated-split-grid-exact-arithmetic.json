  "reproduction_python": "from fractions import Fraction\nM=2**32\nceildiv=lambda a,b:-((-a)//b)\nfor n in range(2,9):\n    counts=[min(M,ceildiv(2*M*(j+1)-n,2*n))-max(0,ceildiv(2*M*j-n,2*n)) for j in range(n)]\n    tv=sum(abs(Fraction(c,M)-Fraction(1,n)) for c in counts)/2\n    bound=max(abs(Fraction(n*c,M)-1) for c in counts)\n    print(n,counts,str(tv),str(bound))\n",
